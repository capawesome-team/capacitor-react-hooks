{
  "name": "capacitor-react-hooks-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "fmt": "turbo run fmt",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "16.1.2",
    "prettier": "3.6.2",
    "turbo": "2.10.1"
  },
  "lint-staged": {
    "**/*.{css,html,ts,tsx,js,json,md}": "prettier --write"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
